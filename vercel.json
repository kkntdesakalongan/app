{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "api": {
      "root": "apps/api",
      "framework": "hono",
      "entrypoint": "vercel.mjs",
      "buildCommand": "pnpm run build"
    },
    "web": {
      "root": "apps/web",
      "framework": "vite",
      "buildCommand": "pnpm run build",
      "outputDirectory": "dist",
      "rewrites": [
        { "source": "/(.*)", "destination": "/index.html" }
      ]
    }
  },
  "rewrites": [
    { "source": "/api/:path*", "destination": { "service": "api" } },
    { "source": "/health", "destination": { "service": "api" } },
    { "source": "/openapi.json", "destination": { "service": "api" } },
    { "source": "/me", "destination": { "service": "api" } },
    { "source": "/files/:path*", "destination": { "service": "api" } },
    { "source": "/users/:path*", "destination": { "service": "api" } },
    { "source": "/roles/:path*", "destination": { "service": "api" } },
    { "source": "/permissions/:path*", "destination": { "service": "api" } },
    { "source": "/(.*)", "destination": { "service": "web" } }
  ]
}
